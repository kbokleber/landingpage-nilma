# ============================================================
# .env é OPCIONAL. Os valores reais ficam salvos em data/blog.db
# (tabela settings) e podem ser editados pela aba "Configurações"
# do painel admin. Este arquivo serve apenas como fallback na
# primeira inicialização, quando o banco ainda não tem esses
# registros. Edite à vontade — após migrar, pode remover.
# ============================================================

# Porta do servidor (padrão: 3001)
# PORT=3001

# Senha administrativa (padrão: nilma-admin)
# ADMIN_PASSWORD=nilma-admin

# Google Cloud OAuth (Business Profile API)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/google/callback

# Resource name da location (ex: accounts/123456789/locations/987654321)
# GBP_LOCATION_NAME=

# Blog API
# BLOG_DB_PATH=data/blog.db
# BLOG_UPLOAD_DIR=data/uploads/blog
# BLOG_UPLOAD_MAX_MB=5
