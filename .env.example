# ============================================================
# .env é OPCIONAL. Configurações ficam em data/blog.db (settings).
# Usuários do painel ficam na tabela users (senha com hash scrypt).
# ============================================================

# Porta do servidor (padrão: 3001)
# PORT=3001

# Só na PRIMEIRA inicialização: se não existir nenhum usuário,
# a senha informada aqui é usada para criar o usuário "admin".
# Depois disso, troque a senha em Admin → Usuários.
# Se omitir (ou for o antigo default público), uma senha aleatória
# é gerada e impressa no log do servidor.
# ADMIN_PASSWORD=

# Chave para criptografar API Keys (independente da senha de login)
# SECRETS_KEY=

# Token para reset de emergência: POST /api/admin/reset-password
# ADMIN_RESET_TOKEN=

# Blog API
# BLOG_DB_PATH=data/blog.db
# BLOG_UPLOAD_DIR=data/uploads/blog
# BLOG_UPLOAD_MAX_MB=5
